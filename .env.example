# 服務配置
SERVICE_MODE=unified  # unified | api-only | mcp-only
MCP_TRANSPORT=stdio  # stdio | streamable-http
PORT=8000
HOST=0.0.0.0

# AWS 配置
# 選項 1: 使用 AWS Profile (推薦)
# 確保已運行 'aws configure' 配置憑證
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
# AWS_PROFILE=default  # 可選：指定特定的 AWS profile

# 選項 2: 使用環境變數 (不推薦用於生產環境)
# AWS_ACCESS_KEY_ID=your_access_key_here
# AWS_SECRET_ACCESS_KEY=your_secret_key_here

# LLM 配置（AWS Bedrock）
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_REGION=us-east-1

# 新聞 API 配置
NEWS_API_KEY=your-news-api-key-here
NEWS_API_PROVIDER=google  # google | newsapi

# 快取配置
CACHE_DIR=.cache
CACHE_TTL=3600

# 日誌配置
LOG_LEVEL=info
LOG_FORMAT=json

# 速率限制
REFINE_LIMIT_PER_HOUR=5

# API 認證
API_KEYS=test-api-key-1,test-api-key-2

# LangChain Feature Flags
# 啟用 LangChain Agent 工具調用（自動編排工作流程）
FEATURE_LANGCHAIN_AGENT=false

# 啟用 LangChain RAG（檢索增強生成，需要配置 CHROMA_URL）
FEATURE_LANGCHAIN_RAG=false

# 啟用 LangChain Memory（多輪對話記憶）
FEATURE_LANGCHAIN_MEMORY=false

# Chroma 向量資料庫配置（當 FEATURE_LANGCHAIN_RAG=true 時需要）
CHROMA_URL=http://localhost:8000
CHROMA_USERNAME=admin
CHROMA_PASSWORD=your_chroma_password_here
CHROMA_TELEMETRY=FALSE

# Chroma 部署配置（用於 docker-compose.chroma.yml）
CHROMA_PORT=8000
CHROMA_UI_PORT=3001
CHROMA_AUTH_PROVIDER=chromadb.auth.token.TokenAuthCredentialsProvider
CHROMA_AUTH_TOKEN=
CHROMA_AUTH_HEADER=X-Chroma-Token
