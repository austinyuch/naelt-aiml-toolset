{
  "family": "advocacy-content-generator",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::123456789012:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::123456789012:role/advocacyContentGeneratorTaskRole",
  "containerDefinitions": [
    {
      "name": "api",
      "image": "123456789012.dkr.ecr.us-east-1.amazonaws.com/advocacy-content-generator:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 3000,
          "protocol": "tcp",
          "appProtocol": "http"
        }
      ],
      "environment": [
        {
          "name": "SERVICE_MODE",
          "value": "unified"
        },
        {
          "name": "PORT",
          "value": "3000"
        },
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "AWS_REGION",
          "value": "us-east-1"
        },
        {
          "name": "BEDROCK_MODEL_ID",
          "value": "anthropic.claude-sonnet-4-5-20250929-v1:0"
        },
        {
          "name": "BEDROCK_REGION",
          "value": "us-east-1"
        },
        {
          "name": "LOG_LEVEL",
          "value": "INFO"
        },
        {
          "name": "CACHE_DIR",
          "value": "/mnt/efs/cache"
        },
        {
          "name": "CACHE_TTL",
          "value": "3600"
        },
        {
          "name": "REFINE_LIMIT_PER_HOUR",
          "value": "5"
        }
      ],
      "secrets": [
        {
          "name": "NEWS_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:123456789012:secret:advocacy-content-generator/news-api-key:NEWS_API_KEY::"
        },
        {
          "name": "API_KEYS",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:123456789012:secret:advocacy-content-generator/api-keys:API_KEYS::"
        }
      ],
      "mountPoints": [
        {
          "sourceVolume": "efs-cache",
          "containerPath": "/mnt/efs/cache",
          "readOnly": false
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/advocacy-content-generator",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "api",
          "awslogs-create-group": "true"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -f http://localhost:3000/health || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      },
      "ulimits": [
        {
          "name": "nofile",
          "softLimit": 65536,
          "hardLimit": 65536
        }
      ],
      "stopTimeout": 30
    }
  ],
  "volumes": [
    {
      "name": "efs-cache",
      "efsVolumeConfiguration": {
        "fileSystemId": "fs-12345678",
        "rootDirectory": "/",
        "transitEncryption": "ENABLED",
        "transitEncryptionPort": 2049,
        "authorizationConfig": {
          "iam": "ENABLED"
        }
      }
    }
  ],
  "tags": [
    {
      "key": "Project",
      "value": "advocacy-content-generator"
    },
    {
      "key": "Environment",
      "value": "production"
    },
    {
      "key": "ManagedBy",
      "value": "github-actions"
    }
  ]
}
